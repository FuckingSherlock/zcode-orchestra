ORCHESTRA_TOKEN=change-me
ORCHESTRA_PORT=8787
ORCHESTRA_TRANSPORT=http
ORCHESTRA_MAX_PARALLEL=2
ORCHESTRA_START_STAGGER_MS=20000

# --- Автоклейм (планировщик discovery+claim внутри сервера) ---
ORCHESTRA_CLAIM_AUTO=1
ORCHESTRA_CLAIM_INTERVAL_MS=600000

# --- Уведомления: CF Worker-релей (worker/notify-worker.js), токен бота живёт в воркере ---
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# --- Пользователи MCP: свой токен, свои аккаунты, свой Telegram chat ---
# Без ORCHESTRA_USERS — один «default» с ORCHESTRA_TOKEN и доступом ко всем аккаунтам.
# ORCHESTRA_USERS=[{"name":"warlock","token":"<длинный-случайный>","accounts":["*"],"chatId":123456789}]
