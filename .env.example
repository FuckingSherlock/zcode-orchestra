# Bearer-токен для HTTP-доступа к MCP (обязателен в http-режиме)
ORCHESTRA_TOKEN=change-me
# Порт HTTP-транспорта (хост и контейнер)
ORCHESTRA_PORT=8787
# Транспорт: http | stdio
ORCHESTRA_TRANSPORT=http
# Максимум параллельных сессий zcode (на сервере 1.9 ГБ RAM не задирайте)
ORCHESTRA_MAX_PARALLEL=2

# Аккаунты (JSON-массив); credentialsFile/providerConfigFile — абсолютные пути для изоляции аккаунтов
# ORCHESTRA_ACCOUNTS=[{"name":"main","credentialsFile":null,"providerConfigFile":null,"model":"account:zai-start-plan/GLM-5.3-Flash"}]

# Каталог журнала задач (jobs.json + jobs/*.log)
# ORCHESTRA_DATA_DIR=/app/data
# База для относительных workdir
# ORCHESTRA_WORKDIR_ROOT=/workspace
# Бинарник zcode CLI
# ORCHESTRA_ZCODE_BIN=zcode
# Доп. JSON-файл конфига (env имеет приоритет над файлом)
# ORCHESTRA_CONFIG=
